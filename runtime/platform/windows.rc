// The .exe's icon (Makefile: windres -I docs/icon). ID 1: Explorer and the taskbar use the first icon resource.
1 ICON "icon.ico"

// What Explorer's properties and the Task Manager show
1 VERSIONINFO
FILEVERSION 0, 1, 6, 0
PRODUCTVERSION 0, 1, 6, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Power Moon Recomp"
            VALUE "ProductName", "Power Moon Recomp"
            VALUE "FileVersion", "0.1.6"
            VALUE "ProductVersion", "0.1.6"
            VALUE "OriginalFilename", "PowerMoonRecomp.exe"
            VALUE "LegalCopyright", "MIT License. Not affiliated with Nintendo."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
