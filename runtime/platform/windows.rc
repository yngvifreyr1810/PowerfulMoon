// The .exe's icon (Makefile: windres -I docs/icon). ID 1: Explorer and the taskbar use the first icon resource.
1 ICON "icon.ico"

// What Explorer's properties and the Task Manager show
1 VERSIONINFO
FILEVERSION 0, 2, 1, 1
PRODUCTVERSION 0, 2, 1, 1
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "PowerfulMoon"
            VALUE "ProductName", "PowerfulMoon"
            VALUE "FileVersion", "0.2.1-powerfulmoon.1"
            VALUE "ProductVersion", "0.2.1-powerfulmoon.1"
            VALUE "OriginalFilename", "PowerfulMoon.exe"
            VALUE "LegalCopyright", "MIT License. Not affiliated with Nintendo."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
